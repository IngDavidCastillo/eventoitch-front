# Copia este archivo como .env.local y ajusta las URLs si cambias de puerto o subes los servicios.
# En Vite, solo las variables que empiezan con VITE_ llegan al navegador (no pongas secretos aqui).
# En la nube (Vercel) estas mismas variables se ponen en Settings > Environment Variables, con las URL https publicas,
# por ejemplo VITE_AGENDA_URL=https://ms-agenda.onrender.com (sin / al final).
VITE_AUTH_URL=http://localhost:8082
VITE_USUARIOS_URL=http://localhost:8081
VITE_AGENDA_URL=http://localhost:8086

# Servicios de Roberta (opcionales). Si se dejan vacios, el front muestra los espacios y eventos por id.
# Si estan registrados en Eureka, se usa la direccion de Eureka y estas solo son respaldo.
VITE_ESPACIOS_URL=
VITE_EVENTOS_URL=
VITE_CATEGORIAS_URL=
# Espacios a revisar cuando ms-espacios no responde
VITE_ESPACIOS_RESPALDO=1,2,3,4

# Servidor Eureka del equipo (lo usa el indicador de servicios de la barra). Sin VITE_: solo lo lee Vite, no el navegador.
# En local, Vite pasa /eureka a esta direccion. En Vercel lo hace vercel.json (hay que poner ahi la URL publica de Eureka).
EUREKA_URL=http://localhost:8761
