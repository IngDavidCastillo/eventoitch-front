# Copia este archivo como .env.local y ajusta las URLs si cambias de puerto o subes los servicios.
# En Vite, solo las variables que empiezan con VITE_ llegan al navegador (no pongas secretos aqui).
VITE_AUTH_URL=http://localhost:8082
VITE_USUARIOS_URL=http://localhost:8081
VITE_AGENDA_URL=http://localhost:8086

# Servicios de Roberta (opcionales). Si se dejan vacios, el front muestra los espacios y eventos por id.
VITE_ESPACIOS_URL=
VITE_EVENTOS_URL=
VITE_CATEGORIAS_URL=
# Espacios a revisar cuando ms-espacios no responde
VITE_ESPACIOS_RESPALDO=1,2,3,4
